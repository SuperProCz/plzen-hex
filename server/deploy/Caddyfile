# HTTPS with an automatic Let's Encrypt certificate. sslip.io resolves 92-5-185-123.sslip.io to 92.5.185.123.
# Access logging is off (Caddy's default), so client IPs aren't written anywhere.
92-5-185-123.sslip.io {
	encode zstd gzip

	handle /api/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:8787
	}

	# The web app (Vite build in /srv/plzen-hex): game at /, dashboard at /dashboard/.
	handle {
		root * /srv/plzen-hex
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /data/* Cache-Control "no-cache"
		header /*.html Cache-Control "no-cache"
		header / Cache-Control "no-cache"
		header /dashboard/ Cache-Control "no-cache"
		file_server
	}
}
